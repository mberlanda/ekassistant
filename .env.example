# Copy to .env and adjust. See docs/design/api-gateway-identity.md and
# docs/decisions/0004-local-llm-serving-via-ollama.md /
# docs/decisions/0006-embedding-model-choice.md for why these defaults were chosen.

# --- Model layer (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Vector index (Qdrant, via docker-compose) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ekassistant_chunks
# Must match OLLAMA_EMBED_MODEL's output size (768 for nomic-embed-text).
EMBEDDING_DIMENSIONS=768

# --- Keyword index (SQLite FTS5, embedded) ---
KEYWORD_INDEX_PATH=./data/keyword_index.sqlite3

# --- Mock identity (see docs/decisions/0007-mock-identity-and-group-lookup.md) ---
IDENTITIES_PATH=./config/identities.yaml
DEFAULT_USER=guest

# --- Ingest (see docs/design/ingest.md) ---
SEED_CORPUS_DIR=./seed_corpus
SEED_CORPUS_MANIFEST=./seed_corpus/manifest.yaml

# --- Observability (see docs/design/observability.md) ---
TRACE_LOG_PATH=./data/traces.jsonl
