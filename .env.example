# Copy to .env and adjust. See docs/design/api-gateway-identity.md and
# docs/decisions/0004-local-llm-serving-via-ollama.md /
# docs/decisions/0006-embedding-model-choice.md for why these defaults were chosen.

# --- Model layer (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
# To try a larger chat model without editing this file, pass it per-run:
# `make eval OLLAMA_MODEL=granite4.1:8b` (see the README's "Trying a larger
# chat model"). An env var set that way outranks this file.
OLLAMA_MODEL=llama3.2:1b
# Not overridable via make, unlike OLLAMA_MODEL - changing this also means
# changing EMBEDDING_DIMENSIONS below and re-running `make ingest`.
OLLAMA_EMBED_MODEL=nomic-embed-text
# Generation temperature - matches Ollama's own stock default (a lower
# value was tried and measured worse across repeated live testing, see
# models/generation.py's DEFAULT_TEMPERATURE). Overridable per-request;
# see the TUI's `:temp` command.
OLLAMA_TEMPERATURE=0.8

# --- Vector index (Qdrant, via docker-compose) ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=ekassistant_chunks
# Must match OLLAMA_EMBED_MODEL's output size (768 for nomic-embed-text).
EMBEDDING_DIMENSIONS=768

# --- Keyword index (SQLite FTS5, embedded) ---
KEYWORD_INDEX_PATH=./data/keyword_index.sqlite3

# --- Mock identity (see docs/decisions/0007-mock-identity-and-group-lookup.md) ---
IDENTITIES_PATH=./config/identities.yaml
DEFAULT_USER=guest

# --- Ingest (see docs/design/ingest.md) ---
SEED_CORPUS_DIR=./seed_corpus
SEED_CORPUS_MANIFEST=./seed_corpus/manifest.yaml

# --- Web crawler connector (see docs/decisions/0010-web-crawler-connector.md) ---
CRAWL_TARGETS_PATH=./config/crawl_targets.yaml

# --- Observability (see docs/design/observability.md) ---
TRACE_LOG_PATH=./data/traces.jsonl

# --- Agent capabilities and policy (V2) ---
# See docs/design/capabilities.md and docs/design/policy.md. Both files are
# mocks in the same sense identities.yaml is (ADR-0007): real decision
# vocabulary, static backing store.
POLICIES_PATH=./config/policies.yaml
# Narrowing the `enabled:` list in this file is the supported way to run a
# deployment that can, say, research the web but cannot send anything.
CAPABILITIES_PATH=./config/capabilities.yaml
# Separate from TRACE_LOG_PATH on purpose: an audit record answers "what was
# this authorized to do", a trace answers "how did it behave". Different
# readers, different retention.
AUDIT_LOG_PATH=./data/capability_audit.jsonl
